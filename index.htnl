<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>SONORA | 作曲スタジオ</title>
    <script src="https://unpkg.com/wanakana@4.0.2/umd/wanakana.min.js"></script>


<style id="account-library-styles-fix">
/* アカウント・マイソングUI */
.account-bar{display:flex;justify-content:flex-end;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 16px}
.account-pill{font-size:13px;color:#cdd4f4;padding:8px 12px;border:1px solid #414a70;border-radius:999px;background:#171d35}
.account-btn,.save-project-btn{border:1px solid #7569d8;border-radius:12px;padding:10px 15px;background:#29254d;color:#fff;font:inherit;font-weight:700;cursor:pointer}
.account-btn:hover,.save-project-btn:hover{background:#3b3372;border-color:#a89cff}
.save-project-btn{margin:12px 0;background:linear-gradient(135deg,#6757df,#387fbd);border:0}
.auth-overlay{position:fixed;inset:0;z-index:10000;background:rgba(5,8,20,.78);display:flex;align-items:center;justify-content:center;padding:18px;overflow:auto}
.auth-overlay[hidden]{display:none!important}
.auth-dialog{width:min(100%,480px);max-height:calc(100dvh - 36px);overflow:auto;background:#141a30;border:1px solid #4b5480;border-radius:22px;padding:24px;color:#f5f6ff;box-shadow:0 24px 90px #0008}
.auth-dialog h2{margin:0 0 8px;font-size:1.5rem}.auth-dialog p{color:#c4cbe8;line-height:1.6}
.auth-dialog label{display:block;margin:14px 0 6px;font-weight:650}.auth-dialog input{box-sizing:border-box;width:100%;padding:12px;border:1px solid #4b5480;border-radius:10px;background:#0e1326;color:#fff;font:inherit}
.auth-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.auth-actions button{flex:1;min-width:120px}
.auth-note{font-size:12px!important;color:#aeb8df!important;border-top:1px solid #343c60;padding-top:12px;margin-top:18px}
.library-list{display:grid;gap:10px;margin-top:16px}.saved-song{border:1px solid #414a70;border-radius:14px;padding:14px;background:#1b223d}.saved-song h3{margin:0 0 5px;font-size:1rem}.saved-song p{margin:4px 0;font-size:13px}.saved-song-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.saved-song-actions button{padding:8px 10px;border-radius:9px;border:1px solid #59648f;background:#252d4d;color:#fff;cursor:pointer}
@media(max-width:600px){.auth-dialog{padding:18px}.account-bar{justify-content:flex-start}.account-btn{padding:9px 11px}}


.output-primary-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:8px 0 18px}
.output-primary-actions button{min-height:46px}
@media(max-width:600px){.output-primary-actions{display:grid;grid-template-columns:minmax(0,1fr);}.output-primary-actions button{width:100%;box-sizing:border-box}}
</style>




<style id="staffNotationStyles">
.staff-notation-panel{position:fixed;inset:0;z-index:2147483000;margin:0;padding:clamp(12px,2.5vw,28px);border:0;border-radius:0;background:#10152b;color:#f4f6ff;width:100%;height:100%;height:100dvh;max-width:none;box-sizing:border-box;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;display:flex;flex-direction:column;gap:12px}
.staff-notation-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;flex:0 0 auto}.staff-notation-close{font-size:1rem;padding:10px 16px;border-radius:10px;border:1px solid #aab6ff;background:#28345f;color:#fff;cursor:pointer;white-space:nowrap}.staff-notation-close:focus-visible{outline:3px solid #fff;outline-offset:2px}.staff-notation-head h3{margin:0 0 6px}.staff-notation-head p,.staff-notation-note{font-size:.9rem;opacity:.82;margin:4px 0 12px}.staff-notation-head button{flex-shrink:0}.staff-notation-part{margin-top:8px;min-width:0;flex:0 0 auto}.staff-notation-part h4{margin:0 0 8px}.staff-notation-scroll{overflow-x:auto;overflow-y:hidden;background:#fff;color:#20243a;border-radius:10px;padding:8px;min-height:118px;max-width:100%;box-sizing:border-box}.staff-notation-scroll svg{display:block;max-width:none;height:auto}.staff-notation-scroll{width:100%;max-width:100%;overflow-x:auto;overscroll-behavior-x:contain}.staff-notation-panel{min-width:0}.staff-notation-panel[hidden]{display:none!important}.staff-notation-panel .staff-notation-head>div{min-width:0;flex:1}.staff-notation-panel .staff-notation-scroll{width:100%;max-width:100%}.staff-notation-panel .staff-notation-scroll svg{max-width:none}.staff-notation-panel .staff-notation-note{padding-bottom:12px}.staff-edit-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#20294a;border:1px solid #56638f;border-radius:12px;padding:12px;margin:4px 0}.staff-edit-toolbar strong{color:#fff}.staff-edit-toolbar span{font-size:.88rem;opacity:.9}.staff-edit-toolbar label{font-size:.9rem}.staff-edit-toolbar select,.staff-edit-toolbar button{border-radius:8px;padding:9px 11px;border:1px solid #9ba9e5;background:#f7f8ff;color:#20294a;font-weight:600}.staff-edit-toolbar button:disabled{opacity:.45}.staff-edit-toolbar #staffEditStatus{flex-basis:100%;color:#dbe4ff}.staff-notation-scroll svg .staff-note-hit{cursor:pointer;touch-action:manipulation}.staff-notation-scroll svg .staff-note-hit.selected ellipse{stroke:#e34b75!important;stroke-width:3.2!important;filter:drop-shadow(0 0 2px #f5a0b6)}.staff-notation-scroll svg .staff-add-hit{cursor:crosshair;touch-action:pan-x pan-y}.staff-empty{color:#555;padding:24px 12px;margin:0}.staff-notation-note{margin-top:12px;margin-bottom:0}
.staff-compare-tools{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 14px;border:1px solid #3d496f;border-radius:12px;background:#171e3a;flex:0 0 auto}.staff-compare-tools strong{font-size:.95rem}.staff-compare-tools p{margin:4px 0 0;font-size:.84rem;opacity:.82;line-height:1.5}.staff-compare-actions{display:flex;gap:8px;flex-wrap:wrap}.staff-compare-actions button{padding:9px 12px;border-radius:9px;border:1px solid #6574ad;background:#27345d;color:#fff;font-weight:700;cursor:pointer}.staff-compare-actions button:disabled{opacity:.4;cursor:not-allowed}


</style>




<style>
.staff-quick-settings{margin:12px 0 16px;padding:14px;border:1px solid var(--studio-border,#46506a);border-radius:14px;background:var(--studio-panel,#171d2b);color:var(--studio-text,#eef2ff)}
.staff-quick-settings h4{margin:0 0 6px;font-size:1.05rem}.staff-quick-settings p{margin:4px 0 10px;color:var(--studio-muted,#b5bfd4);font-size:.9rem}
.staff-quick-setting-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin:10px 0}
.staff-quick-field{display:flex;flex-direction:column;gap:5px;min-width:0}.staff-quick-field label,.staff-quick-lyrics label{font-weight:650;font-size:.9rem}
.staff-quick-field select,.staff-quick-lyrics textarea{width:100%;box-sizing:border-box}.staff-quick-lyrics{display:grid;grid-template-columns:1fr;gap:6px;margin-top:12px}
#staffQuickApply{margin-top:10px;padding:9px 13px;border-radius:9px;cursor:pointer}
</style>


<style>
.staff-term-help{margin:12px 0;padding:12px 14px;border:1px solid #56638f;border-radius:10px;background:#131a31;color:#eef2ff}
.staff-term-help summary{cursor:pointer;font-weight:700;padding:2px 0}
.staff-term-help dl{display:grid;grid-template-columns:minmax(120px,170px) minmax(0,1fr);gap:8px 14px;margin:14px 0 8px;line-height:1.55}
.staff-term-help dt{font-weight:700;color:#cbd5ff}
.staff-term-help dd{margin:0;color:#e0e5f8}
.staff-term-note{font-size:.88rem!important;opacity:.88;margin:12px 0 0!important}
@media(max-width:620px){.staff-term-help dl{grid-template-columns:1fr;gap:3px}.staff-term-help dd{margin-bottom:8px}}
</style>
</head>
<body>
<style>
        textarea {
            width: 100%;
            height: 100px;
            background: #fffaf0;
            border-bottom: solid 3px #e8e6e1;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.25);
            border-radius: 9px;
            border-top: solid 2px #1dc1d6;
        }
        .goo {
            margin-top: 10px;
            font-size:17px;
            padding: 5px 10px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            width: 10em;
           height:20em;
           text-align: center;
            box-shadow: -5px 5px 0px #1567C3;
            transition: .3s;
        }
        .goo:hover{
          background-position: right center;
          background-size: 300% auto;
          -webkit-animation: pulse 1s infinite;
          animation: ripple 0.75s infinite;
          color: #fff;
          box-shadow: unset;
          transform: translate(-4px,4px);
          letter-spacing: 0.20em;
          text-indent: 0.20em;
        }
        @keyframes ripple {
          0% {box-shadow: 0 0 0 0 #1B85FB;}
          70% {box-shadow: 0 0 0 10px rgb(27 133 251 / 0%);}
          100% {box-shadow: 0 0 0 0 rgb(27 133 251 / 0%);}
        }
        header {
            color: #b22222;
            height: 200px;
            width: 90%;
            background-image: repeating-linear-gradient(115deg, rgba(255, 0, 0, 1), rgba(250, 159, 21, 1) 15%, rgba(169, 255, 34, 1) 32%, rgba(93, 192, 93, 1) 46%, rgba(100, 174, 180, 1) 60%, rgba(39, 73, 238, 1) 73%, rgba(157, 37, 243, 1) 86%, rgba(255, 0, 0, 1));
            background-size: 800% 800%;
            animation: GradietionAnimation 10s ease infinite;
            color: white;
            text-align: center;
            padding: 10px;
            border-radius: 15px;
            max-width: 952px;
            margin: 0 auto;
            padding: 12px 24px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 120px;
            weigh:100%;
            font-weight: bold;
            font-size: 75px;
            box-shadow: 0 3px 4px rgba(0, 0, 0, 0.4);/*影*/
        }
  @keyframes GradietionAnimation { 
  0%{background-position:0% 50%}
  50%{background-position:100% 50%}
  100%{background-position:0% 50%}
}
        h1 {
            font-size: 75px;
            -webkit-text-stroke: 2px #adff2f;
            text-stroke: 2px #adff2f;
            text-align: center;
            align-items: center;
            weigh:100%;
            height:100%;




  }
        .image{
            color: #d3d3d3;
  }
  
        select{
            background-color: #fff8dc;/*背景色*/
            border-top: solid 4px #1dc1d6;
            box-shadow: 0 3px 4px rgba(0, 0, 0, 0.1);/*影*/
            font-size: 15px;
  }
        label{
            font-size: 18px;
  }
       .input{
            font-weight: normal;
            font-size:18px;
  }
       .aa{
          color:#0645ad;
         vertical-align: middle;
          box-shadow: 0 3px 4px rgba(0, 0, 0, 0.3);/*影*/
         height:200%;
  }
       .aaa{
                    line-height:1.5;
          font-size:15px;
  }
       .imagin{
         font-size;23px;
  }
       .hahaha{
         font-size;20px;
  }
        .number{
          font-size:15px;
          line-height:1.5;
        }
        .tempo-image{
          font-size:15px;
          line-height:1.5;
        }
        .Metronom{
          color:#1d3994;
          font-size:21px;
        }
        .important{
          color:#ff0000;
          font-weight: bold;
        }
        .sound{
          font-size:15px;
          line-height:10px;
          line-height:1.5;
        }
        .scale{
          font-size:15px;
          line-height:10px;
                    line-height:1.5;
        }
        .fonts{
          font-size:15px;
          line-height:10px;
        }
        .Alert{
          color: #ff0000;
          line-height:1.5;
        }
  body{
          line-height:2.0;
  }
          .container {
          width: 100%;
          height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
      }
  
      .animate {
        font-size: 50px;
        font-family:sans-serif;
        text-align: center;








      }
      .animate span {
        display: inline-block;
      }




      .animate span:nth-of-type(2) {
        animation-delay: .05s;
      }
      .animate span:nth-of-type(3) {
        animation-delay: .1s;
      }
      .animate span:nth-of-type(4) {
        animation-delay: .15s;
      }
      .animate span:nth-of-type(5) {
        animation-delay: .2s;
      }
      .animate span:nth-of-type(6) {
        animation-delay: .25s;
      }
      .animate span:nth-of-type(7) {
        animation-delay: .3s;
      }
      .animate span:nth-of-type(8) {
        animation-delay: .35s;
      }
      .animate span:nth-of-type(9) {
        animation-delay: .4s;
      }
      .animate span:nth-of-type(10) {
        animation-delay: .45s;
      }
      .animate span:nth-of-type(11) {
        animation-delay: .5s;
      }
      .animate span:nth-of-type(12) {
        animation-delay: .55s;
      }




      .top-wrapper-txt span {
        opacity: 0;
        transform: translate(-150px, 0) scale(.3);
        animation: leftRight .5s forwards;
      }








      @keyframes leftRight {
        40% {
          transform: translate(50px, 0) scale(.8);
          opacity: 1;
          color: #fff;
        }




        60% {
          color: #fff;
        }




        80% {
          transform: translate(0) scale(3);
          opacity: 0;
        }




        100% {
          transform: translate(0) scale(1);
          opacity: 1;
        }
  }
        .accordion details {
        border: 1px solid #ddd;
        margin-bottom: 5px;
        vertical-align: middle;
      }




      .accordion summary {
        padding: 10px;
        background-color: #e9f5f4;
        cursor: pointer;
        height: 20px;
        vertical-align: middle;
      }




      .accordion .sound {
        vertical-align: middle;
        padding: 10px;
        }
  
      .let{
        font-size:15px;
        }
       .now{
         color:#ff0000;
         font-weight: bold;
         font-size: 25px;
  }
       .word{
         font-style: italic;
  }
  .try{
    background-color:#f5f5f5
  }


/* === Studio UI refresh: visual layer only === */
.hero-start {
  display: block;
  min-width: 190px;
  min-height: 52px;
  margin: 22px auto 0;
  padding: 13px 26px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, #9b8cff, #7865f2);
  color: #fff;
  font-size: 16px;
  font-weight: 750;
  box-shadow: 0 8px 24px rgba(120,101,242,.28);
}
.hero-start:hover { background: linear-gradient(135deg, #afa4ff, #8978ff); transform: translateY(-2px); }
:root {
  color-scheme: dark;
  --studio-bg: #0b0d14;
  --studio-panel: #141925;
  --studio-panel-raised: #1b2231;
  --studio-border: #30394b;
  --studio-text: #edf2ff;
  --studio-muted: #a2acc0;
  --studio-accent: #9b8cff;
  --studio-accent-strong: #7865f2;
  --studio-cyan: #5de1d1;
  --studio-radius: 16px;
  --studio-shadow: 0 16px 44px rgba(0,0,0,.24);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--studio-bg); }
body {
  margin: 0;
  padding: 28px clamp(16px, 4vw, 56px) 64px;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(119,101,242,.18), transparent 42%),
    radial-gradient(ellipse at 100% 35%, rgba(40,186,181,.07), transparent 30%),
    var(--studio-bg);
  color: var(--studio-text);
  font: 16px/1.65 Inter, "Noto Sans JP", system-ui, -apple-system, sans-serif;
}
header {
  width: min(100%, 1120px);
  max-width: 1120px;
  height: auto;
  min-height: 88px;
  margin: 0 auto 28px;
  padding: 16px 24px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 18px;
  background: linear-gradient(120deg, #262346, #182333 62%, #15383c);
  box-shadow: var(--studio-shadow);
  animation: none;
  font-size: 20px;
}
header .container { width: 100%; height: auto; min-height: 48px; }
header .animate { font-size: clamp(25px, 3vw, 38px); font-weight: 800; letter-spacing: .08em; }
header h1, h1 { color: var(--studio-text); -webkit-text-stroke: 0; text-stroke: 0; font-size: clamp(28px, 4vw, 42px); }
.top-ttl, .textanimation { width: min(100%, 900px); margin: 0 auto; text-align: center; }
.top-ttl { padding: 28px 16px 10px; }
.textanimation { color: var(--studio-text); font-size: clamp(26px, 4vw, 44px); line-height: 1.3; font-weight: 800; letter-spacing: .025em; }
.top-ttl::after {
  content: "コトバを、自由に曲にしよう。";
  display: block;
  margin: 14px 0 8px;
  color: var(--studio-muted);
  font-size: clamp(15px, 1.6vw, 19px);
  font-weight: 500;
}
h3 { color: #e4e8ff; margin: 22px 0 10px; font-size: 18px; }
h5.let { width: min(100%, 900px); margin: 14px auto 26px; color: var(--studio-muted); text-align: center; font-size: 15px; font-weight: 500; }
body > label, body > select, body > a, body > br { }
label { display: inline-block; margin: 12px 0 7px; color: #dce3f5; font-size: 14px; font-weight: 650; }
select, input:not([type="range"]), textarea {
  max-width: 100%;
  color: var(--studio-text);
  background: #101522;
  border: 1px solid var(--studio-border);
  border-radius: 10px;
  box-shadow: none;
  padding: 11px 13px;
  font: inherit;
  transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
}
select { min-width: 190px; cursor: pointer; border-top: 1px solid var(--studio-border); }
textarea {
  display: block;
  width: min(100%, 900px);
  min-height: 150px;
  height: auto;
  margin: 8px auto 18px;
  padding: 16px;
  resize: vertical;
  background: #101522;
  border: 1px solid var(--studio-border);
  color: #f2f5ff;
  line-height: 1.7;
  box-shadow: inset 0 2px 8px rgba(0,0,0,.16);
}
textarea::placeholder { color: #77839b; }
:where(button, select, input, textarea, a):focus-visible {
  outline: 3px solid rgba(93,225,209,.55);
  outline-offset: 3px;
}
select:focus, textarea:focus, input:focus {
  border-color: var(--studio-cyan);
  box-shadow: 0 0 0 3px rgba(93,225,209,.12);
}
button {
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid var(--studio-border);
  border-radius: 10px;
  background: var(--studio-panel-raised);
  color: var(--studio-text);
  font: inherit;
  font-size: 14px;
  font-weight: 650;
  cursor: pointer;
  transition: transform .16s ease, background .16s ease, border-color .16s ease, box-shadow .16s ease;
}
button:hover { background: #293248; border-color: #596681; }
button:active { transform: translateY(1px); }
button:disabled { opacity: .42; cursor: not-allowed; }
.goo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 220px;
  height: auto;
  min-height: 52px;
  margin: 14px 0;
  padding: 14px 24px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--studio-accent), var(--studio-accent-strong));
  color: white;
  box-shadow: 0 8px 22px rgba(120,101,242,.26);
  font-size: 16px;
  letter-spacing: 0;
  text-indent: 0;
}
.goo:hover { background: linear-gradient(135deg, #afa4ff, #8978ff); box-shadow: 0 10px 28px rgba(120,101,242,.34); transform: translateY(-2px); animation: none; letter-spacing: 0; text-indent: 0; }
.accordion, details[name="test"], body > details {
  color: var(--studio-muted);
}
details {
  margin: 10px 0;
  overflow: hidden;
  border: 1px solid var(--studio-border) !important;
  border-radius: 12px;
  background: rgba(20,25,37,.78);
}
summary {
  height: auto !important;
  padding: 12px 15px !important;
  background: #1a2130 !important;
  color: #dfe5f7;
  font-weight: 650;
  cursor: pointer;
}
summary:hover { background: #222b3e !important; }
details > div { padding: 12px 16px; }
.aa { color: #dfe5f7; box-shadow: none; height: auto; }
.sound, .scale, .aaa, .fonts, .tempo-image, .number { color: var(--studio-muted); }
.sound p, .scale p, .aaa p, .fonts p, .tempo-image p, .number p { line-height: 1.7; }
.try { background: #222b3e; color: #e7ecff; border: 1px solid #3a465e; }
.try:hover { background: #303b54; }
a { color: var(--studio-cyan); text-underline-offset: 3px; }
.important, .Alert { color: #ff969d; }
.now { color: var(--studio-cyan); }
.word { color: var(--studio-muted); }
#outputKanjiFullDisplay, #outputRomajiFullDisplay, #outputEmotionAnalysisResult,
#bpm-display, #audioPlayback, #warning {
  display: block;
  width: min(100%, 900px);
  margin: 10px auto;
  padding: 12px 14px;
  border: 1px solid var(--studio-border);
  border-radius: 10px;
  background: var(--studio-panel);
  color: var(--studio-muted);
}
#bpm-slider { accent-color: var(--studio-accent); max-width: 100%; }
#audioPlayback { width: min(100%, 900px); }
#inputTextA, #inputText { width: min(100%, 900px); }
img { max-width: 100%; }
@media (min-width: 1000px) {
  body { max-width: 1440px; margin: 0 auto; }
}
@media (max-width: 640px) {
  body { padding: 14px 14px 40px; }
  header { padding: 12px 16px; min-height: 70px; }
  header .animate { font-size: 27px; }
  select { width: 100%; min-width: 0; }
  .goo { width: 100%; min-width: 0; }
  textarea { min-height: 130px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
}




/* 画面遷移・モード管理（既存の作曲処理には触れない） */
.mode-gate { max-width: 980px; margin: 8vh auto 40px; padding: 28px; text-align: center; }
.mode-gate h1 { margin-bottom: 8px; }
.mode-gate p { color: var(--studio-muted, #aeb7d7); }
.mode-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 28px; }
.mode-card { display: block; text-align: left; min-height: 190px; padding: 24px; border: 1px solid #414a70; border-radius: 20px; background: #171d35; color: #f4f6ff; cursor: pointer; }
.mode-card:hover, .mode-card:focus-visible { border-color: #9a8cff; transform: translateY(-2px); outline: 2px solid #9a8cff; }
.mode-card strong { display: block; font-size: 1.35rem; margin-bottom: 10px; }
.mode-card span { color: #bdc5e5; line-height: 1.7; }
.workflow-nav { position: sticky; top: 8px; z-index: 20; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; margin: 12px auto 22px; padding: 10px; border: 1px solid #343d60; border-radius: 16px; background: rgba(15, 19, 37, .94); backdrop-filter: blur(12px); }
.workflow-nav button { padding: 10px 14px; border-radius: 999px; border: 1px solid #465078; background: #202744; color: #f4f6ff; cursor: pointer; }
.workflow-nav button[aria-current="step"] { background: #7866ef; border-color: #a89cff; }
.workflow-nav .mode-status { color: #bfc7e8; font-size: .9rem; padding: 0 8px; }
.workflow-screen { max-width: 1100px; margin: 0 auto; }
.workflow-screen[hidden], #mainApp[hidden], #modeGate[hidden] { display: none !important; }
.screen-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin: 26px 0 12px; }
.screen-actions button { padding: 11px 18px; border-radius: 12px; border: 1px solid #626e9a; background: #252d4b; color: #fff; cursor: pointer; }
.screen-actions .primary { background: #7866ef; border-color: #a89cff; }
body[data-mode="easy"] .advanced-mode-note { display: none; }
@media (max-width: 640px) { .mode-gate { padding: 16px; margin-top: 24px; } .mode-cards { grid-template-columns: 1fr; } .mode-card { min-height: auto; } .workflow-nav { top: 4px; } .workflow-nav button { padding: 9px 11px; } }
/* モード別の1画面1項目UI。画面内に収め、ページ自体はスクロールさせない */
html, body { min-height: 100%; }
body { overflow: hidden; }
#mainApp { height: 100dvh; overflow: hidden; display: flex; flex-direction: column; }
#mainApp > header { display: none; }
#mainApp[hidden] { display: none !important; }
.workflow-nav { flex: 0 0 auto; margin: 8px auto 4px; padding: 7px 10px; max-width: calc(100% - 20px); }
.workflow-nav [data-step] { display: none; }
#pageDeck { flex: 1 1 auto; min-height: 0; display: flex; justify-content: center; align-items: stretch; overflow: hidden; padding: 8px 16px 16px; }
#pageDeck[hidden] { display: none !important; }
.app-page { width: min(100%, 820px); height: 100%; min-height: 0; overflow: hidden; display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: 16px; padding: clamp(16px, 3vh, 30px) clamp(14px, 4vw, 44px); border: 1px solid #343d60; border-radius: 22px; background: linear-gradient(145deg, rgba(28,35,63,.98), rgba(17,22,42,.98)); box-sizing: border-box; }
.app-page[hidden] { display: none !important; }
.app-page h1, .app-page h2 { margin: 0; text-align: center; }
.app-page .page-kicker { text-align: center; color: #aeb7d7; margin: 0; }
.app-page .field-label { display: block; margin: 0; color: #f4f6ff; font-size: clamp(1rem, 2.3vh, 1.25rem); }
.app-page select, .app-page textarea { width: 100%; max-width: 100%; box-sizing: border-box; }
.app-page select { min-height: 48px; }
.app-page textarea { min-height: 120px; max-height: 24vh; resize: vertical; }
.app-page .field-card { display: flex; flex-direction: column; gap: 12px; width: 100%; }
.app-page .page-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 8px; }
.app-page .page-actions button { min-height: 44px; padding: 10px 18px; border: 1px solid #626e9a; border-radius: 12px; background: #252d4b; color: #fff; cursor: pointer; }
.app-page .page-actions .primary { background: #7866ef; border-color: #a89cff; }
.app-page .page-actions button:only-child { margin-left: auto; }
.app-page .slider-container { width: 100%; }
.app-page #bpm-slider { width: 100%; }
.app-page .lyric-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; min-height: 0; }
.app-page .lyric-fields > div { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
.app-page #audioPlayback { width: 100%; }
.app-page #warning { color: #fff !important; }
#modeGate { height: 100dvh; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
#modeGate[hidden] { display: none !important; }
@media (max-height: 700px) { .app-page { gap: 10px; padding-top: 10px; padding-bottom: 10px; } .app-page textarea { min-height: 80px; max-height: 19vh; } .mode-gate { margin-top: 0; margin-bottom: 0; } }
@media (max-width: 640px) { .workflow-nav { margin: 5px auto 0; gap: 5px; } .workflow-nav .mode-status { font-size: .78rem; } #pageDeck { padding: 7px; } .app-page { padding: 14px; gap: 12px; border-radius: 16px; } .app-page .lyric-fields { grid-template-columns: 1fr; gap: 10px; } .app-page textarea { min-height: 65px; max-height: 15vh; } .app-page .page-actions button { padding: 9px 12px; } }




/* ホーム画面と高さ不足対策 */
html, body { width:100%; height:100%; min-height:0; }
body { margin:0 !important; padding:0 !important; overflow:hidden !important; }
#homeScreen, #modeGate { width:100%; height:100dvh; min-height:0; box-sizing:border-box; overflow:hidden; }
#homeScreen { display:flex; flex-direction:column; justify-content:center; align-items:center; padding:clamp(18px,4vh,44px) clamp(16px,5vw,64px); background:radial-gradient(ellipse at 50% 0%,rgba(120,101,242,.24),transparent 52%),radial-gradient(ellipse at 95% 85%,rgba(40,186,181,.12),transparent 35%),#0b0d14; }
#homeScreen[hidden], #homePanel[hidden], #modeGate[hidden] { display:none !important; }
.home-inner { width:min(100%,1040px); max-height:100%; display:flex; flex-direction:column; justify-content:center; gap:clamp(12px,2.2vh,24px); }
.home-brand { margin:0; text-align:center; font-size:clamp(30px,5vw,58px); line-height:1.1; letter-spacing:.08em; }
.home-tagline { margin:0; text-align:center; color:#bfc7e8; font-size:clamp(15px,2vw,21px); }
.home-hero { border:1px solid #414a70; border-radius:24px; padding:clamp(18px,4vh,38px); text-align:center; background:linear-gradient(145deg,rgba(35,39,72,.94),rgba(17,27,42,.96)); box-shadow:0 18px 55px rgba(0,0,0,.25); }
.home-hero h2 { margin:0 0 8px; font-size:clamp(22px,3.2vw,34px); }
.home-hero p { margin:0 auto 18px; max-width:650px; color:#bdc5e5; }
.home-primary, .home-menu button, .home-panel-back, #modeGate .home-back { min-height:44px; border:1px solid #a89cff; border-radius:13px; padding:11px 20px; background:#7866ef; color:#fff; font:inherit; font-weight:750; cursor:pointer; }
.home-primary { min-width:min(100%,240px); font-size:clamp(17px,2vw,21px); }
.home-menu { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.home-menu button { background:#1a2138; border-color:#414a70; text-align:left; }
.home-menu button span { display:block; color:#bdc5e5; font-size:.88rem; font-weight:400; margin-top:3px; }
.home-menu button:hover, .home-menu button:focus-visible, .home-primary:hover { filter:brightness(1.12); outline:2px solid #9a8cff; outline-offset:2px; }
#homePanel { border:1px solid #414a70; border-radius:16px; background:#171d35; padding:clamp(12px,2vh,20px); color:#e9edff; }
#homePanel h2 { margin:0 0 8px; font-size:clamp(18px,2.5vw,24px); }
#homePanel p, #homePanel li { margin-top:4px; margin-bottom:4px; color:#bdc5e5; }
.home-panel-back { margin-top:8px; background:#252d4b; border-color:#626e9a; }
#modeGate { margin:0; max-width:none; padding:clamp(16px,4vh,40px); align-items:center; }
#modeGate .mode-cards { width:min(100%,900px); }
#modeGate .home-back { position:absolute; top:12px; left:12px; background:#202744; border-color:#465078; }
#mainApp { height:100dvh; max-height:100dvh; min-height:0; overflow:hidden; }
.workflow-nav { flex-wrap:nowrap; max-width:calc(100% - 16px); margin:6px auto 2px; padding:5px 8px; gap:6px; }
.workflow-nav button { white-space:nowrap; font-size:clamp(11px,1.3vw,14px); padding:8px 11px; }
#pageDeck { padding:6px 12px 10px; }
.app-page { justify-content:flex-start; gap:clamp(8px,1.7vh,16px); padding:clamp(12px,2.3vh,24px) clamp(12px,3vw,36px); }
.app-page h1 { font-size:clamp(22px,3.3vh,34px); line-height:1.15; }
.app-page .page-kicker { font-size:clamp(12px,1.7vh,15px); line-height:1.35; }
.app-page .field-card { gap:7px; }
.app-page label { margin:0; }
.app-page select { min-height:42px; padding:8px 11px; }
.app-page textarea { min-height:clamp(58px,11vh,120px); max-height:19vh; resize:none; }
.app-page .lyric-fields { flex:1 1 auto; align-content:start; }
.app-page .lyric-fields textarea { min-height:clamp(70px,15vh,160px); max-height:24vh; }
.app-page .page-actions { flex:0 0 auto; padding-top:4px; }
#app-page-output { gap:clamp(5px,1vh,10px); }
#app-page-output > *:not(.page-actions) { margin-block:0; max-width:100%; }
#app-page-output button, #app-page-output input, #app-page-output audio { max-width:100%; }
@media (max-height:700px) {
 .home-inner { gap:10px; }
 .home-hero { padding:14px; }
 .home-hero p { margin-bottom:10px; }
 .home-menu { gap:8px; }
 #modeGate .mode-card { min-height:130px; padding:16px; }
 .workflow-nav { margin-top:3px; }
 #pageDeck { padding-top:3px; padding-bottom:5px; }
 .app-page { gap:7px; padding-top:8px; padding-bottom:8px; }
 .app-page .lyric-fields textarea { min-height:60px; max-height:17vh; }
}
@media (max-width:640px) {
 #homeScreen { padding:14px; }
 .home-menu { grid-template-columns:1fr 1fr; gap:8px; }
 .home-menu button { padding:10px; font-size:13px; }
 .home-hero { border-radius:17px; }
 #modeGate .mode-cards { grid-template-columns:1fr; gap:10px; margin-top:12px; }
 #modeGate .mode-card { min-height:0; padding:14px; }
 #modeGate .mode-card strong { font-size:1.1rem; margin-bottom:4px; }
 #modeGate .home-back { top:6px; left:6px; padding:7px 10px; }
 .workflow-nav { justify-content:space-around; width:calc(100% - 10px); max-width:none; }
 .workflow-nav .mode-status { display:none; }
 #pageDeck { padding:4px; }
 .app-page { padding:12px; gap:8px; }
 .app-page .lyric-fields { grid-template-columns:1fr; gap:8px; }
 .app-page .lyric-fields textarea { min-height:clamp(48px,10vh,85px); max-height:14vh; }
 .app-page .page-actions button { min-height:40px; padding:8px 10px; font-size:13px; }
}




/* 選択UIをカード式にし、ホームだけは必要に応じてスクロール可能にする */
html, body { height:auto !important; min-height:100dvh; }
body { overflow-x:hidden !important; overflow-y:auto !important; }
#homeScreen { height:auto !important; min-height:100dvh; overflow:visible !important; justify-content:flex-start; }
#homeScreen .home-inner { max-height:none; padding-block:clamp(18px,4vh,44px); }
#homePanel { max-height:none; }
#mainApp { flex:none; }
.app-page .choice-native-select { position:absolute !important; width:1px !important; height:1px !important; padding:0 !important; margin:-1px !important; overflow:hidden !important; clip:rect(0,0,0,0) !important; white-space:nowrap !important; border:0 !important; }
.app-page .choice-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(125px,1fr)); gap:10px; width:100%; min-height:0; }
.app-page .choice-card { display:flex; align-items:center; justify-content:center; min-height:clamp(46px,7vh,66px); padding:10px 12px; border:1px solid #465078; border-radius:14px; background:linear-gradient(145deg,#202744,#171d35); color:#edf0ff; font:inherit; font-weight:650; text-align:center; line-height:1.2; cursor:pointer; transition:transform .15s,border-color .15s,background .15s,box-shadow .15s; }
.app-page .choice-card:hover, .app-page .choice-card:focus-visible { border-color:#a89cff; outline:2px solid #7866ef; outline-offset:2px; }
.app-page .choice-card.is-selected { border-color:#a89cff; background:linear-gradient(145deg,#6555d9,#3d4f91); box-shadow:0 0 0 2px rgba(168,156,255,.18),0 8px 20px rgba(0,0,0,.16); color:#fff; }
.app-page .choice-grid[data-control="key"] { grid-template-columns:repeat(5,minmax(0,1fr)); gap:7px; }
.app-page .choice-grid[data-control="key"] .choice-card { min-height:clamp(36px,5.5vh,50px); padding:5px 3px; font-size:clamp(11px,1.4vw,14px); }
.app-page .choice-grid[data-control="tempo"] { grid-template-columns:repeat(auto-fit,minmax(75px,1fr)); }
.app-page .choice-grid[data-control="tempo"] .choice-card { min-height:44px; }
@media (max-width:640px) {
  #homeScreen { padding:14px; }
  #homeScreen .home-inner { padding-block:12px 24px; }
  .app-page .choice-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px; }
  .app-page .choice-card { min-height:42px; padding:8px 6px; font-size:13px; }
  .app-page .choice-grid[data-control="key"] { grid-template-columns:repeat(5,minmax(0,1fr)); gap:5px; }
  .app-page .choice-grid[data-control="key"] .choice-card { min-height:35px; font-size:11px; }
  .app-page .choice-grid[data-control="tempo"] { grid-template-columns:repeat(4,minmax(0,1fr)); }
}
@media (max-height:700px) {
  .app-page .choice-grid { gap:6px; }
  .app-page .choice-card { min-height:38px; padding:6px; }
  .app-page .choice-grid[data-control="key"] .choice-card { min-height:32px; }
}


</style>
  
<section id="homeScreen" aria-labelledby="homeTitle">
  <div class="home-inner">
    <div class="account-bar" aria-label="作品メニュー">
      <span class="account-pill">CREATE • PLAY • SAVE</span>
      <button type="button" class="account-btn" onclick="openSongLibrary()">マイソング</button>
    </div>
    <h1 class="home-brand" id="homeTitle">作曲スタジオ</h1>
    <p class="home-tagline">コトバから、あなただけの音楽を。</p>
    <div class="home-hero">
      <h2>思いついた言葉を、曲にしよう。</h2>
      <p>雰囲気や音色を選び、歌詞を入力するだけ。気軽にも、こだわっても、あなたのペースで作曲できます。</p>
      <button type="button" class="home-primary" onclick="goToModeSelection()">♪ 作曲をする</button>
    </div>
    <div class="home-menu" aria-label="ホームメニュー">
      <button type="button" onclick="showHomePanel('intro')">アプリ紹介<span>このアプリでできること</span></button>
      <button type="button" onclick="showHomePanel('flow')">作曲の流れ<span>完成までのステップ</span></button>
    </div>
    <section id="homePanel" hidden aria-live="polite"></section>
  </div>
</section>
<section id="modeGate" class="mode-gate" aria-labelledby="modeGateTitle" hidden>
  <button type="button" class="home-back" onclick="backToHome()">← ホームへ</button>
  <h1 id="modeGateTitle">作曲スタジオへようこそ</h1>
  <p>作り方を選んで、あなたの言葉を音楽にしましょう。</p>
  <div class="mode-cards">
    <button type="button" class="mode-card" onclick="startComposer('easy')">
      <strong>簡単モード</strong>
      <span>まずは歌詞づくりから。設定を少なめにして、すぐに曲を作り始めます。</span>
    </button>
    <button type="button" class="mode-card" onclick="startComposer('pro')">
      <strong>本格モード</strong>
      <span>音色・音階・キー・テンポ・ドラムなどを細かく調整できます。音色・音階・キー・テンポ・ドラムなどを調整できます。</span>
    </button>
  </div>
</section>
<div id="mainApp" hidden>
<nav class="workflow-nav" aria-label="作曲ステップ">
  <button type="button" data-step="settings" onclick="showComposerScreen('settings')">1. 曲の設定</button>
  <button type="button" data-step="lyrics" onclick="showComposerScreen('lyrics')">2. 歌詞づくり</button>
  <button type="button" data-step="output" onclick="showComposerScreen('output')">3. 生成・録音</button>
  <span class="mode-status" id="modeStatus">モード：未選択</span>
  <button type="button" onclick="backToModeSelection()">モード変更</button>
</nav>
<header>
  <div class="container">
  <div class="animate top-wrapper-txt">
    <span>作</span><span>曲</span><span>ア</span><span>プ</span><span>リ</span>
    </div>  
    </div>
  
</header>




<section id="screen-settings" class="workflow-screen" data-screen="settings">
    <div class="top-ttl">
<div class="textanimation">あなたの音楽を、ここから。</div>
    <button type="button" class="hero-start" onclick="showComposerScreen('lyrics');">曲を作る</button>
    </div>




<h5 class=let>手順は簡単です。始めましょう。</h5>
 
  
  <select id="atmosphere">
          <option>選択してください</option>
  <option>とても明るい雰囲気</option>
  <option>これから頑張りたいとき</option>
  <option>悲しい雰囲気</option>
  <option>怒っている雰囲気</option>
  </select>
  <a href="#inputting" onclick="showComposerScreen('lyrics')">アルファベット入力へスキップ</a>




   <br>
  
  <label for="waveform">①音色を選択してください</label>
      <select id="waveform">
    <option value="sine">選択してください</option>
        <option value="sine">サイン波</option>
    <option value="square">矩形波</option>
    <option value="sawtooth">のこぎり波</option>
    <option value="triangle">三角波</option>
    <option value="piano">ピアノ</option>
    <option value="violin">バイオリン</option>
    <option value="trumpet">トランペット</option>
    <option value="flute">フルート</option>
    <option value="clarinet">クラリネット</option>
  </select>
  <div class="part-instrument-controls" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:16px 0;padding:16px;border:1px solid rgba(150,130,255,.35);border-radius:14px;background:rgba(110,90,180,.08)">
    <div><label for="waveformA">Aメロの音色</label><select id="waveformA" class="part-waveform"><option value="piano">ピアノ</option><option value="sine">サイン波</option><option value="triangle">三角波</option><option value="sawtooth">のこぎり波</option><option value="square">矩形波</option><option value="violin">バイオリン</option><option value="trumpet">トランペット</option><option value="flute">フルート</option><option value="clarinet">クラリネット</option></select></div>
    <div><label for="waveformB">Bメロの音色</label><select id="waveformB" class="part-waveform"><option value="piano">ピアノ</option><option value="sine">サイン波</option><option value="triangle">三角波</option><option value="sawtooth">のこぎり波</option><option value="square">矩形波</option><option value="violin">バイオリン</option><option value="trumpet">トランペット</option><option value="flute">フルート</option><option value="clarinet">クラリネット</option></select></div>
    <div><label for="waveformAccomp">伴奏の音色</label><select id="waveformAccomp" class="part-waveform"><option value="triangle">三角波</option><option value="piano">ピアノ</option><option value="sine">サイン波</option><option value="sawtooth">のこぎり波</option><option value="square">矩形波</option><option value="violin">バイオリン</option><option value="trumpet">トランペット</option><option value="flute">フルート</option><option value="clarinet">クラリネット</option></select></div>
    <p style="grid-column:1/-1;margin:0;font-size:.9em;opacity:.8">パートごとに音色を設定できます。上の「全体の音色」は既存の試聴・共通設定として残しています。</p>
  </div>
        <div class="accordion">
  <details name="test" class=shine>
<summary class=aa>詳細情報<span class=Oh> (ここをクリック)</span></summary>
    <div class=sound>
      <h3 class=imagin>音についての説明</h3>
      <p><span class=class>サイン波</span>は明瞭な音です。透明感があります。</p>
      <button onclick="play1()" class=try> サイン波の音色</button>
      
      <p><span class=class>短形波</span>は鋭い音です</p>
      <p class=Alert><span class=camera> </span><span class=rika><img src=https://ebipop.com/wp-content/uploads/2018/12/kiken.png width="15" height="15" alt="警告"></span>短形波は音が大きいです。</p>
      <button onclick="play2()" class=try> 短形波の音色</button>




      <p><span class=class>のこぎり波</span>は明るい音です</p>
      <p class=Alert><span class=camera> </span><span class=rika><img src=https://ebipop.com/wp-content/uploads/2018/12/kiken.png width="15" height="15" alt="警告"></span>のこぎり波は音が大きいです。</p>
      <button onclick="play3()" class=try> のこぎり波</button>




      <p><span class=class>三角波</span>はまろやかで優しい音です。</p>
