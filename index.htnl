            <div id="editModeNotice" class="post-create-editor" hidden>
  <div class="post-create-heading"><span>ARRANGE MODE</span><h2>アレンジ編集中</h2><p>文字や音色を変えて、再生してみましょう。元の曲はいつでも復元できます。</p></div>
  <h3 class="current-settings-title">現在の設定 <small>項目を押すと、その設定の編集場所へ移動します</small></h3>
  <div id="currentSettingsList" class="current-settings-list" aria-label="現在の設定一覧"></div>
  <div class="post-create-actions"><button type="button" onclick="undoSongEdits()">元の曲に戻す</button><button type="button" onclick="showComposerScreen('output')">再生・保存へ進む →</button></div>
  <p id="editModeFeedback" aria-live="polite"></p>
</div>
<h3>Aメロ（伴奏なし・四分音符）</h3>
<textarea id="inputTextA" maxlength="400" rows="4" cols="50" placeholder="Aメロを入力..."></textarea>




<h3>Bメロ（これまでの自由なリズム）</h3>
<textarea id="inputText" maxlength="400" rows="4" cols="50" placeholder="Bメロを入力..."></textarea>
<p class=word>現在の文字数: <span id="charCount" class=now>0</span>/400</p>




   <label>⑥ボタンを押しましょう。</label>
            <br>
  
<div class="screen-actions"><button type="button" onclick="showComposerScreen('settings')">← 曲の設定へ戻る</button><button type="button" class="primary" onclick="showComposerScreen('output')">生成・録音へ進む →</button></div>
</section>
<section id="screen-output" class="workflow-screen" data-screen="output" hidden>
<div class="output-primary-actions" aria-label="曲の操作">
  <button type="button" onclick="playFullSong()" class="goo">音楽を生成する</button>
  <button type="button" class="save-project-btn" onclick="saveCurrentSong()">曲を保存する</button>
  <button type="button" id="showStaffNotationButton" class="save-project-btn" aria-expanded="false" onclick="toggleStaffNotation()">楽譜を表示・曲を編集</button>
</div>
<section id="staffNotationPanel" hidden class="staff-notation-panel" aria-label="楽譜表示・曲の編集">
  <div class="staff-notation-head"><div><h3>楽譜表示・曲の編集</h3><p>楽譜を確認しながら、雰囲気・音色・調・キー・テンポ・ドラム・文字列を編集できます。</p></div><div style="display:flex;gap:8px;flex-wrap:wrap"><button type="button" id="refreshStaffNotation">譜面を更新</button><button type="button" class="staff-notation-close" id="closeStaffNotationButton" onclick="closeStaffNotation()">✕ 閉じる</button></div></div>
  <div id="staffCompareTools" class="staff-compare-tools" aria-label="変更前と変更後の比較">
    <div><strong>文字と音符をつなげて見る</strong><p id="staffCompareStatus" aria-live="polite">文字を編集すると、変更前と現在のAメロを聴き比べられます。</p></div>
    <div class="staff-compare-actions"><button type="button" id="playStaffBefore">変更前のAメロ</button><button type="button" id="playStaffAfter">現在のAメロ</button></div>
  </div>
  <div class="staff-edit-toolbar" role="group" aria-label="五線譜の直接編集">
    <strong>✍️ 楽譜を直接編集</strong><span>音符をクリックして選択し、ボタンで音程・臨時記号を変更。五線譜の空白をクリックして追加。</span>
    <label for="staffNoteDuration">追加する音符</label><select id="staffNoteDuration"><option value="0.25">16分音符</option><option value="0.5">8分音符</option><option value="1" selected>4分音符</option><option value="2">2分音符</option><option value="4">全音符</option></select>
    <button type="button" id="staffPitchUp" disabled>↑ 上の音</button><button type="button" id="staffPitchDown" disabled>↓ 下の音</button><button type="button" id="staffSharp" disabled>♯ シャープ</button><button type="button" id="staffFlat" disabled>♭ フラット</button><button type="button" id="staffNatural" disabled>♮ ナチュラル</button><button type="button" id="staffApplyDuration" disabled>選択音符の長さを変更</button><button type="button" id="staffDeleteSelected" disabled>選択音符を削除</button><button type="button" id="staffPlayEdited">▶ 編集したメロディーを再生</button><button type="button" id="staffResetEdits">編集を取り消す</button>
    <span id="staffEditStatus" aria-live="polite">音符を選択するか、五線譜の空白をタップしてください。</span>
  </div>


  <section id="staffQuickSettings" class="staff-quick-settings" aria-label="曲の設定と文字列の編集">
    <h4>🎛️ 曲の設定・入力文字列をここで編集</h4>
    <p>ここで変更した内容は元の設定にも反映されます。まず「曲の雰囲気」を選ぶと、音色やテンポなどが自動で選ばれる場合があります。そのあとで、好みに合わせて個別に変更できます。</p>
    <div id="staffQuickSettingFields" class="staff-quick-setting-grid"></div>


    <div class="staff-quick-lyrics">
      <label for="staffQuickInputTextA">Aメロの文字列</label>
      <textarea id="staffQuickInputTextA" rows="3" maxlength="400" placeholder="Aメロを入力..."></textarea>
      <label for="staffQuickInputText">Bメロの文字列</label>
      <textarea id="staffQuickInputText" rows="3" maxlength="400" placeholder="Bメロを入力..."></textarea>
    </div>
    <button type="button" id="staffQuickApply">文字列・設定を反映して譜面を更新</button>
    <p id="staffQuickStatus" aria-live="polite"></p>
  </section>


  <div id="staffTranspositionSettings" class="staff-edit-toolbar" role="group" aria-label="転調の設定" style="margin-top:12px">
    <strong>🎼 転調の設定</strong>
    <span>位置と幅を変更すると、Bメロの五線譜と再生に反映されます。</span>
  <label for="transpositionSemitones">転調の幅</label>
  <select id="transpositionSemitones">
    <option value="1" selected>半音上（+1）</option>
    <option value="2">全音上（+2）</option>
    <option value="3">短3度上（+3）</option>
    <option value="5">完全4度上（+5）</option>
    <option value="7">完全5度上（+7）</option>
    <option value="12">1オクターブ上（+12）</option>
    <option value="-1">半音下（−1）</option>
    <option value="-2">全音下（−2）</option>
    <option value="-3">短3度下（−3）</option>
    <option value="-5">完全4度下（−5）</option>
    <option value="-7">完全5度下（−7）</option>
    <option value="0">転調しない（0）</option>
  </select>
  <label for="transpositionPositionMode" style="display:block;margin-top:10px">転調を始める位置</label>
  <select id="transpositionPositionMode">
    <option value="auto" selected>自動（従来の設定）</option>
    <option value="last5">最後の5文字から</option>
    <option value="last10">最後の10文字から</option>
    <option value="last15">最後の15文字から</option>
    <option value="last20">最後の20文字から</option>
    <option value="last20pct">最後の20％から</option>
    <option value="last30pct">最後の30％から</option>
    <option value="atCharacter">指定した文字から</option>
  </select>
  <div id="transpositionCharacterSetting" hidden style="margin-top:8px">
    <label for="transpositionStartCharacter">転調開始文字（1文字目から数える）</label>
    <input id="transpositionStartCharacter" type="number" min="1" value="21" step="1" style="max-width:140px">
  </div>
  <p class="class">五線譜には転調開始位置を縦線と「ここから転調」のラベルで表示します。自動設定では31〜100文字は最後の10文字、101文字以上は最後の20％から転調します。設定を変更すると五線譜と再生に反映されます。</p>


  </div>
  <div class="staff-notation-part"><div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap"><h4>Aメロ</h4><button type="button" id="copyStaffAStringButton" class="copy-lyric-string" onclick="copyEditedLyricString('inputTextA')">Aメロの文字列をコピー</button><button type="button" class="copy-lyric-string" onclick="downloadEditedLyricText('inputTextA','Aメロ.txt')">Aメロを保存（TXT）</button><button type="button" id="downloadStaffAButton">Aメロを保存（SVG）</button></div><div id="staffAView" class="staff-notation-scroll"><p class="staff-empty">Aメロを入力すると五線譜が表示されます。</p></div></div>
  <div class="staff-notation-part"><div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap"><h4>Bメロ</h4><button type="button" id="copyStaffBStringButton" class="copy-lyric-string" onclick="copyEditedLyricString('inputText')">Bメロの文字列をコピー</button><button type="button" class="copy-lyric-string" onclick="downloadEditedLyricText('inputText','Bメロ.txt')">Bメロを保存（TXT）</button><button type="button" id="downloadStaffBButton">Bメロを保存（SVG）</button></div><div id="staffBView" class="staff-notation-scroll"><p class="staff-empty">Bメロを入力すると五線譜が表示されます。</p></div></div>
  <p class="staff-notation-note">操作：音符をクリックして選択し、「上の音／下の音」や♯・♭・♮ボタンで変更します。長さを変えると、その小節以降の音符の開始位置も連動して移動し、音符どうしが重なりにくいリズムを保ちます。空白クリックで音符を追加できます。再生ボタンは編集したAメロとBメロを順番に再生します。伴奏・ドラムは元の曲のままです。</p>
</section>


<div id="postCreateEditor" class="post-create-editor" hidden>
  <div class="post-create-heading"><span>✦ YOUR TRACK IS READY</span><h2>編集・保存メニュー</h2><p>このメニューは楽譜の編集画面とは別の場所にあります。「元の曲に戻す」は編集を始める前の状態へ戻し、「別バージョンとして保存」は元の曲を残したまま編集版を新しく保存します。</p></div>
  <div class="post-create-actions">
    <button type="button" onclick="undoSongEdits()">↶ 元の曲に戻す</button>
    <button type="button" onclick="saveEditedVersion()">別バージョンとして保存</button>
  </div>
  <p id="editTrackFeedback" aria-live="polite"></p>
</div>
<p id="saveSongFeedback" aria-live="polite" style="color:#cbd4ff;margin:4px 0 12px"></p>
<div class="cover-studio" id="coverStudio">
  <div class="cover-heading"><span class="cover-kicker">YOUR ARTWORK</span><h2>曲のジャケットをつくろう</h2><p>タイトルとアートを選んで、自分だけの1枚に。</p></div>
  <label class="cover-title-label" for="coverTitle">曲名</label>
  <input id="coverTitle" class="cover-title-input" maxlength="48" placeholder="例：夜明けのメロディ" value="My New Song">
  <div class="cover-themes" role="group" aria-label="ジャケットのテーマ">
    <button type="button" class="cover-theme is-selected" data-theme="aurora" aria-pressed="true"><span class="theme-art theme-aurora"></span><b>オーロラ</b></button>
    <button type="button" class="cover-theme" data-theme="sunset" aria-pressed="false"><span class="theme-art theme-sunset"></span><b>サンセット</b></button>
    <button type="button" class="cover-theme" data-theme="cosmic" aria-pressed="false"><span class="theme-art theme-cosmic"></span><b>コズミック</b></button>
    <button type="button" class="cover-theme" data-theme="bloom" aria-pressed="false"><span class="theme-art theme-bloom"></span><b>ブルーム</b></button>
  </div>
  <div class="cover-preview-wrap"><div id="coverPreview" class="cover-preview theme-aurora" role="img" aria-label="作成中の曲ジャケット"><span class="cover-preview-orb"></span><span class="cover-preview-label">ORIGINAL TRACK</span><strong id="coverPreviewTitle">MY NEW SONG</strong><span class="cover-preview-bottom">COMPOSE YOUR WORLD</span></div></div>
  <button type="button" class="cover-download-btn" onclick="downloadSongCover()">ジャケットを画像で保存</button>
</div>
          <br>
     
            
            <button id="startBtn">録音開始</button>
  <button id="stopBtn" disabled>録音停止</button>
            <button id="deleteBtn" disabled>録音を削除</button>




  <a id="downloadLink" style="display: none;">録音をダウンロード</a>
  <br><br>
  <audio id="audioPlayback" controls></audio>
            
<p id="warning" style="color: black;"></p>






<div class="screen-actions"><button type="button" onclick="showComposerScreen('lyrics')">← 曲づくりへ戻る</button></div>
</section>
</div>
<script>


// ホームとモード選択画面の切り替え
function goToModeSelection() {
  document.getElementById('homeScreen').hidden = true;
  document.getElementById('homePanel').hidden = true;
  document.getElementById('modeGate').hidden = false;
  document.getElementById('mainApp').hidden = true;
}
function backToHome() {
  document.getElementById('mainApp').hidden = true;
  document.getElementById('modeGate').hidden = true;
  document.getElementById('homeScreen').hidden = false;
  window.scrollTo(0,0);
}
function showHomePanel(kind) {
  const panel = document.getElementById('homePanel');
  panel.hidden = false;
  if (kind === 'intro') {
    panel.innerHTML = '<h2>アプリ紹介</h2><p>歌詞や雰囲気、音の設定を組み合わせて、オリジナルの曲づくりを楽しめる作曲アプリです。</p><p>簡単モードは「曲の雰囲気」と「Bメロ」だけ。本格モードは音色・音階・キー・テンポ・ドラム・Aメロ／Bメロを設定できます。</p>';
  } else {
    panel.innerHTML = '<h2>作曲の流れ</h2><ol><li>「作曲をする」を押してモードを選択</li><li>各ページで雰囲気や音楽設定を選ぶ</li><li>歌詞を入力して曲を生成・再生</li></ol>';
  }
  if (!panel.querySelector('.home-panel-back')) {
    const back = document.createElement('button');
    back.type = 'button'; back.className = 'home-panel-back'; back.textContent = '閉じる';
    back.onclick = () => { panel.hidden = true; };
    panel.appendChild(back);
  }
}


// モード別ページ制御。既存の入力要素とイベントを移動して再利用します。
let composerMode = null;
let composerScreen = 'mood';
let composerPagesBuilt = false;
let composerPageOrder = [];


function makeAppPage(id, title, description) {
  const page = document.createElement('section');
  page.className = 'app-page';
  page.id = 'app-page-' + id;
  page.dataset.page = id;
  page.hidden = true;
  const h = document.createElement('h1'); h.textContent = title; page.appendChild(h);
  if (description) { const p = document.createElement('p'); p.className = 'page-kicker'; p.textContent = description; page.appendChild(p); }
  const actions = document.createElement('div'); actions.className = 'page-actions';
  page.appendChild(actions);
  document.getElementById('pageDeck').appendChild(page);
  return page;
}
function addPageActions(page, back, next, nextLabel) {
  const actions = page.querySelector('.page-actions');
  if (back) { const b = document.createElement('button'); b.type='button'; b.textContent='← 戻る'; b.onclick=()=>showComposerScreen(back); actions.appendChild(b); }
  const n = document.createElement('button'); n.type='button'; n.className='primary'; n.textContent=nextLabel || '次へ →'; n.onclick=()=>showComposerScreen(next); actions.appendChild(n);
}
function moveField(id, page, labelText) {
  const control = document.getElementById(id);
  if (!control) return null;
  let label = document.querySelector('label[for="' + id + '"]');
  const card = document.createElement('div'); card.className='field-card';
  if (label) { label.classList.add('field-label'); card.appendChild(label); }
  else if (labelText) { label=document.createElement('label'); label.className='field-label'; label.htmlFor=id; label.textContent=labelText; card.appendChild(label); }
  card.appendChild(control);
  if (control.tagName === 'SELECT') {
    const grid = document.createElement('div');
    grid.className = 'choice-grid';
    grid.dataset.control = id;
    grid.setAttribute('role', 'group');
    grid.setAttribute('aria-label', labelText || id);
    Array.from(control.options).forEach(option => {
      const text = option.textContent.trim();
      if (!text || text.includes('選択してください')) return;
      const choice = document.createElement('button');
      choice.type = 'button';
      choice.className = 'choice-card';
      choice.textContent = text;
      choice.setAttribute('aria-pressed', String(control.value === option.value));
      choice.onclick = () => {
        control.value = option.value;
        control.dispatchEvent(new Event('change', { bubbles: true }));
        grid.querySelectorAll('.choice-card').forEach(btn => {
          const selected = btn.dataset.value === control.value;
          btn.classList.toggle('is-selected', selected);
          btn.setAttribute('aria-pressed', String(selected));
        });
      };
      choice.dataset.value = option.value;
      if (control.value === option.value) choice.classList.add('is-selected');
      grid.appendChild(choice);
    });
    control.classList.add('choice-native-select');
    card.appendChild(grid);
    control.addEventListener('change', () => {
      grid.querySelectorAll('.choice-card').forEach(btn => {
        const selected = btn.dataset.value === control.value;
        btn.classList.toggle('is-selected', selected);
        btn.setAttribute('aria-pressed', String(selected));
      });
    });
  }
  page.insertBefore(card, page.querySelector('.page-actions'));
  return card;
}
function downloadEditedLyricText(fieldId, fileName){
  const field=document.getElementById(fieldId);
  if(!field){return;}
  const value=field.value||'';
  const blob=new Blob(['\ufeff',value],{type:'text/plain;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const link=document.createElement('a');
  link.href=url; link.download=fileName; link.style.display='none';
  document.body.appendChild(link); link.click(); link.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
  const feedback=document.getElementById('saveSongFeedback')||document.getElementById('staffEditStatus');
  if(feedback) feedback.textContent='TEXTファイルを保存しました。';
}


async function copyEditedLyricString(fieldId){
  const field = document.getElementById(fieldId);
  const buttonId = fieldId === 'inputTextA' ? 'copyStaffAStringButton' : 'copyStaffBStringButton';
  const button = document.getElementById(buttonId);
  if (!field) {
    alert('コピーする文字列が見つかりません。');
    return;
  }
  const value = field.value || '';
  if (!value.trim()) {
    alert('コピーする文字列が空です。先に文字列を入力してください。');
    field.focus();
    return;
  }


  let copied = false;
  // Clipboard API is preferred when the browser permits it.
  try {
    if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
      await navigator.clipboard.writeText(value);
      copied = true;
    }
  } catch (err) {
    // Local HTML files and some browser contexts block Clipboard API; use fallback below.
  }


  // Fallback for browsers that block navigator.clipboard (including many file:// contexts).
  if (!copied) {
    const temp = document.createElement('textarea');
    temp.value = value;
    temp.setAttribute('aria-hidden', 'true');
    temp.style.position = 'fixed';
    temp.style.left = '8px';
    temp.style.top = '8px';
    temp.style.width = '2px';
    temp.style.height = '2px';
    temp.style.padding = '0';
    temp.style.border = '0';
    temp.style.opacity = '0.01';
    document.body.appendChild(temp);
    temp.focus();
    temp.select();
    temp.setSelectionRange(0, temp.value.length);
    try { copied = document.execCommand('copy'); } catch (err) { copied = false; }
    temp.remove();
  }


  if (copied) {
    if (button) {
      const originalLabel = button.dataset.originalLabel || button.textContent;
      button.dataset.originalLabel = originalLabel;
      button.textContent = '✓ コピー完了';
      button.disabled = true;
      setTimeout(() => {
        if (button.isConnected) {
          button.textContent = originalLabel;
          button.disabled = false;
        }
      }, 2200);
    }
    alert('コピー完了！文字列をクリップボードにコピーしました。');
  } else {
    // Leave the text selected so the user can complete the copy manually if browser policy blocks it.
    field.focus();
    field.select();
    alert('自動コピーがブラウザにブロックされました。文字列を選択したので、Ctrl+C（Macは⌘C）でコピーしてください。');
  }
}




function buildComposerPages() {
  if (composerPagesBuilt) return;
  const main = document.getElementById('mainApp');
  const nav = main.querySelector('.workflow-nav');
  const deck = document.createElement('div'); deck.id='pageDeck';
  nav.insertAdjacentElement('afterend', deck);
  // 古いまとめ画面は使わず、既存コントロールだけを新しいページへ移動します。
  const oldScreens = ['screen-settings','screen-lyrics','screen-output'].map(id=>document.getElementById(id)).filter(Boolean);
  const mood = makeAppPage('mood','曲の雰囲気','雰囲気をひとつ選んでください。');
  moveField('atmosphere', mood, '曲の雰囲気');
  const wave = makeAppPage('wave','音色','曲全体の音の質感を選びます。');
  moveField('waveform', wave, '音色');
  const scale = makeAppPage('scale','音階','メロディに使う音階を選びます。');
  moveField('scaleType', scale, '音階');
  const key = makeAppPage('key','キー','曲の基準となるキーを選びます。');
  moveField('key', key, 'キー');
  const tempo = makeAppPage('tempo','テンポ','曲の速さを選びます。');
  moveField('tempo', tempo, 'テンポ');
  const bpm = document.getElementById('bpm-slider');
  if (bpm) { const slider = bpm.closest('.slider-container'); if (slider) tempo.insertBefore(slider, tempo.querySelector('.page-actions')); }
  const beat = makeAppPage('beat','ドラム','ビートパターンを選びます。');
  moveField('beatType', beat, 'ドラム／ビートパターン');
  const lyrics = makeAppPage('lyrics','メロディ入力','本格モードではAメロとBメロを入力できます。');




  const lyricFields=document.createElement('div'); lyricFields.className='lyric-fields';
  const aWrap=document.createElement('div'); const aTitle=document.createElement('label'); aTitle.className='field-label'; aTitle.htmlFor='inputTextA'; aTitle.textContent='Aメロ'; aWrap.appendChild(aTitle); const a=document.getElementById('inputTextA'); if(a) aWrap.appendChild(a); const txtA=document.createElement('button'); txtA.type='button'; txtA.className='copy-lyric-string'; txtA.textContent='⬇ AメロをTEXTファイルで保存'; txtA.onclick=()=>downloadEditedLyricText('inputTextA','Aメロ.txt'); aWrap.appendChild(txtA); lyricFields.appendChild(aWrap);
  const bWrap=document.createElement('div'); bWrap.id='proBWrap'; const bTitle=document.createElement('label'); bTitle.className='field-label'; bTitle.htmlFor='inputText'; bTitle.textContent='Bメロ'; bWrap.appendChild(bTitle); const b=document.getElementById('inputText'); if(b) bWrap.appendChild(b); const count=document.getElementById('charCount'); if(count && count.parentElement) bWrap.appendChild(count.parentElement); const txtB=document.createElement('button'); txtB.type='button'; txtB.className='copy-lyric-string'; txtB.textContent='⬇ BメロをTEXTファイルで保存'; txtB.onclick=()=>downloadEditedLyricText('inputText','Bメロ.txt'); bWrap.appendChild(txtB); lyricFields.appendChild(bWrap);
  lyrics.insertBefore(lyricFields, lyrics.querySelector('.page-actions'));
  const easyLyrics=makeAppPage('easy-lyrics','Bメロ入力','Bメロだけ入力すればOKです。');
  const easyBWrap=document.createElement('div'); easyBWrap.id='easyBWrap'; easyBWrap.className='field-card'; const easyBLabel=document.createElement('label'); easyBLabel.className='field-label'; easyBLabel.htmlFor='inputText'; easyBLabel.textContent='Bメロ'; easyBWrap.appendChild(easyBLabel); if(b) easyBWrap.appendChild(b); if(count && count.parentElement) easyBWrap.appendChild(count.parentElement); const txtEasyB=document.createElement('button'); txtEasyB.type='button'; txtEasyB.className='copy-lyric-string'; txtEasyB.textContent='⬇ BメロをTEXTファイルで保存'; txtEasyB.onclick=()=>downloadEditedLyricText('inputText','Bメロ.txt'); easyBWrap.appendChild(txtEasyB); easyLyrics.insertBefore(easyBWrap,easyLyrics.querySelector('.page-actions'));
  // A/B入力は本格モードと簡単モードで同じBメロ要素を共有します。
  const output=makeAppPage('output','生成・録音','曲を生成して、必要なら録音してください。');
  const oldOutput=document.getElementById('screen-output');
  if(oldOutput) Array.from(oldOutput.children).forEach(el=>{ if(!el.classList.contains('screen-actions')) output.insertBefore(el,output.querySelector('.page-actions')); });
  // 既存の説明用・旧レイアウトは非表示。操作要素は上記ページへ移動済み。
  oldScreens.forEach(el=>{ if(el) el.hidden=true; });
  const extra=document.getElementById('start-stop-button'); if(extra) tempo.appendChild(extra);
  // 各ページの進む／戻るボタン
  addPageActions(mood,null,'wave','次へ →');
  mood.querySelector('.page-actions .primary').onclick=()=>showComposerScreen(composerMode==='easy'?'easy-lyrics':'wave');
  addPageActions(wave,'mood','scale'); addPageActions(scale,'wave','key'); addPageActions(key,'scale','tempo'); addPageActions(tempo,'key','beat'); addPageActions(beat,'tempo','lyrics');
  addPageActions(lyrics,'beat','output','生成・録音へ →');
  addPageActions(easyLyrics,'mood','output','生成・録音へ →');
  addPageActions(output,'lyrics','output','');
  // outputページの最後の自己遷移ボタンは不要
  const outActions=output.querySelector('.page-actions'); outActions.innerHTML='';
  const backOut=document.createElement('button'); backOut.type='button'; backOut.textContent='← 入力へ戻る'; backOut.onclick=()=>showComposerScreen(composerMode==='easy'?'easy-lyrics':'lyrics'); outActions.appendChild(backOut);
  composerPagesBuilt=true;
}
function startComposer(mode) {
  composerMode = mode === 'easy' ? 'easy' : 'pro';
  buildComposerPages();
  document.body.dataset.mode = composerMode;
  document.getElementById('modeGate').hidden = true;
  document.getElementById('mainApp').hidden = false;
  document.getElementById('modeStatus').textContent = 'モード：' + (composerMode === 'easy' ? '簡単モード' : '本格モード');
  document.querySelectorAll('.workflow-nav [data-step]').forEach(b=>b.style.display='none');
  showComposerScreen(composerMode === 'easy' ? 'mood' : 'wave');
}
function showComposerScreen(screen) {
  const easyOrder=['mood','easy-lyrics','output'];
  const proOrder=['wave','scale','key','tempo','beat','lyrics','output'];
  const order=composerMode==='easy'?easyOrder:proOrder;
  if (!order.includes(screen)) return;
  composerPageOrder=order;
  composerScreen=screen;
  document.querySelectorAll('#pageDeck .app-page').forEach(page=>page.hidden=page.dataset.page!==screen);
  const active=document.getElementById('app-page-'+screen);
  if(active) active.style.display='flex';
  const b=document.getElementById('inputText');
  const count=document.getElementById('charCount');
  const countRow=count && count.parentElement;
  const targetWrap=document.getElementById(composerMode==='easy'?'easyBWrap':'proBWrap');
  if(b && targetWrap) { targetWrap.appendChild(b); if(countRow) targetWrap.appendChild(countRow); }
  // 簡単モードでは設定項目を雰囲気とBメロだけに制限
  document.body.dataset.mode=composerMode;
  window.scrollTo(0,0);
}
function backToModeSelection() {
  document.getElementById('mainApp').hidden = true;
  document.getElementById('modeGate').hidden = false;
  window.scrollTo(0,0);
}




  
  
  // JavaScriptの playDrumPattern 関数の中身を以下のように変更してください




function playDrumPattern(audioContext, startTime, tempo, duration, beatType) {




  const beatPatterns = {
    "8beat":   [ "kick", "hat", "snare", "hat", "kick", "hat", "snare", "hat" ],
    "16beat":  [ "kick", "hat", "hat", "snare", "hat", "hat", "kick", "hat", "hat", "snare", "hat", "hat", "kick", "hat", "hat", "snare" ],
    "rock":    [ "crash", "kick", "snare", "hat", "kick", "hat", "snare", "hat" ],
    "funk":    [ "kick", "hat", "snare", "hat", "kick", "kick", "snare", "hat" ],
    "pop":     [ "kick", "hat", "snare", "hat", "kick", "snare", "kick", "hat" ],
    "ballad":  [ "crash", "kick", "hat", "snare", "hat", "hat", "snare", "hat" ],
    /* ▼ここから新しいビートの定義を追加▼ */
    "techno":  [ "kick", "ohat", "kick", "ohat", "kick", "ohat", "snare", "ohat" ],
    "dnb":     [ "kick", "hat", "hat", "snare", "hat", "kick", "hat", "hat", "kick", "hat", "hat", "snare", "hat", "kick", "kick", "hat" ],
    "trap":    [ "kick", "hat", "hat", "hat", "snare", "hat", "kick", "hat", "kick", "hat", "hat", "hat", "snare", "hat", "hat", "hat" ],
    /* ▲ここまで追加▲ */
    "none":    []
  };




  if (!beatPatterns[beatType]) return;




  const pattern = beatPatterns[beatType];
  const steps = pattern.length;
  if (steps === 0) return;
  const interval = (60 / tempo) * 4 / steps;




  const drumGain = audioContext.createGain();
  drumGain.connect(audioContext.destination);




  let current = startTime;
  for (let i = 0; i < Math.floor(duration / interval); i++) {
    const sound = pattern[i % steps];
    switch (sound) {
      case "kick": playKick(audioContext, current, drumGain); break;
      case "snare": playSnare(audioContext, current, drumGain); break;
      case "hat": playHiHat(audioContext, current, drumGain); break;
      case "ohat": playOpenHat(audioContext, current, drumGain); break;
      case "crash": playCrash(audioContext, current, drumGain); break;
      case "tomlow": playTom(audioContext, current, drumGain, "low"); break;
      case "tomhi": playTom(audioContext, current, drumGain, "high"); break;
    }
    current += interval;
  }
}
  function playKick(audioContext, time, output) {
  const osc = audioContext.createOscillator();
  osc.type = "sine";
  osc.frequency.setValueAtTime(150, time);
  osc.frequency.exponentialRampToValueAtTime(50, time + 0.1);




  const gain = audioContext.createGain();
  gain.gain.setValueAtTime(1, time);
  gain.gain.exponentialRampToValueAtTime(0.001, time + 0.1);




  osc.connect(gain).connect(output);
  osc.start(time);
  osc.stop(time + 0.1);
}




function playSnare(audioContext, time, output) {
  const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 0.2, audioContext.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;




  const noise = audioContext.createBufferSource();
  noise.buffer = buffer;




  const bandpass = audioContext.createBiquadFilter();
  bandpass.type = "bandpass";
  bandpass.frequency.setValueAtTime(1800, time);




  const gain = audioContext.createGain();
  gain.gain.setValueAtTime(1, time);
  gain.gain.exponentialRampToValueAtTime(0.01, time + 0.2);




  noise.connect(bandpass).connect(gain).connect(output);
  noise.start(time);
  noise.stop(time + 0.2);
}




function playHiHat(audioContext, time, output) {
  const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 0.05, audioContext.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;




  const noise = audioContext.createBufferSource();
  noise.buffer = buffer;




  const highpass = audioContext.createBiquadFilter();
  highpass.type = "highpass";
  highpass.frequency.setValueAtTime(7000, time);




  const gain = audioContext.createGain();
  gain.gain.setValueAtTime(0.5, time);
  gain.gain.exponentialRampToValueAtTime(0.01, time + 0.05);




  noise.connect(highpass).connect(gain).connect(output);
  noise.start(time);
  noise.stop(time + 0.05);
}




function playOpenHat(audioContext, time, output) {
  const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 0.3, audioContext.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;




  const noise = audioContext.createBufferSource();
  noise.buffer = buffer;




  const highpass = audioContext.createBiquadFilter();
  highpass.type = "highpass";
  highpass.frequency.setValueAtTime(5000, time);




  const gain = audioContext.createGain();
  gain.gain.setValueAtTime(0.4, time);
  gain.gain.exponentialRampToValueAtTime(0.01, time + 0.3);




  noise.connect(highpass).connect(gain).connect(output);
  noise.start(time);
  noise.stop(time + 0.3);
}




function playCrash(audioContext, time, output) {
  const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 1, audioContext.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;




  const noise = audioContext.createBufferSource();
  noise.buffer = buffer;




  const highpass = audioContext.createBiquadFilter();
  highpass.type = "highpass";
  highpass.frequency.setValueAtTime(4000, time);




  const gain = audioContext.createGain();
  gain.gain.setValueAtTime(1, time);
  gain.gain.exponentialRampToValueAtTime(0.01, time + 1);




  noise.connect(highpass).connect(gain).connect(output);
  noise.start(time);
  noise.stop(time + 1);
}




function playTom(audioContext, time, output, type = "low") {
  const osc = audioContext.createOscillator();
  osc.type = "sine";
  const freq = type === "low" ? 100 : 180;
  osc.frequency.setValueAtTime(freq, time);
  osc.frequency.exponentialRampToValueAtTime(freq / 2, time + 0.3);




  const gain = audioContext.createGain();
  gain.gain.setValueAtTime(0.8, time);
  gain.gain.exponentialRampToValueAtTime(0.001, time + 0.3);




  osc.connect(gain).connect(output);
  osc.start(time);
  osc.stop(time + 0.3);
}




  
  //自動選択
   document.getElementById("atmosphere").addEventListener("change", function () {
    const selectedAtmosphereOptionForUser = this.value;




    const waveformSelectionDropdownElement = document.getElementById("waveform");
    const keySelectionDropdownElementForTone = document.getElementById("key");
    const tempoSelectionDropdownElementHere = document.getElementById("tempo");
    const scaleTypeSelectionDropdownMenu = document.getElementById("scaleType");




    if (selectedAtmosphereOptionForUser === "選択してください") {
      waveformSelectionDropdownElement.selectedIndex = 0;
      keySelectionDropdownElementForTone.selectedIndex = 0;
      tempoSelectionDropdownElementHere.selectedIndex = 0;
      scaleTypeSelectionDropdownMenu.selectedIndex = 0;
      return;
    }




    switch (selectedAtmosphereOptionForUser) {
      case "とても明るい雰囲気":
        waveformSelectionDropdownElement.value = "piano"; // 矩形波
        keySelectionDropdownElementForTone.value = "391.995"; // G4
        tempoSelectionDropdownElementHere.value = "2000";
        scaleTypeSelectionDropdownMenu.value = "normal"; // 長音階
        break;
      case "これから頑張りたいとき":
        waveformSelectionDropdownElement.value = "sawtooth"; // のこぎり波
        keySelectionDropdownElementForTone.value = "493.883"; // B4
        tempoSelectionDropdownElementHere.value = "150";
        scaleTypeSelectionDropdownMenu.value = "zenon"; // 全音階
        break;
      case "悲しい雰囲気":
        waveformSelectionDropdownElement.value = "triangle"; // 三角波
        keySelectionDropdownElementForTone.value = "329.628"; // E4
        tempoSelectionDropdownElementHere.value = "70";
        scaleTypeSelectionDropdownMenu.value = "wasei"; // 和声的短音階
        break;
      case "怒っている雰囲気":
        waveformSelectionDropdownElement.value = "sawtooth"; // のこぎり波
        keySelectionDropdownElementForTone.value = "369.994"; // F#4/G♭4
        tempoSelectionDropdownElementHere.value = "140";
        scaleTypeSelectionDropdownMenu.value = "wasei"; // 和声的短音階
        break;
    }
  });
  
  
  //音声入力・感情分析
     const buttonToStartRecognition = document.getElementById('buttonToStartRecognition');
    const buttonToSwitchLanguageMode = document.getElementById('buttonToSwitchLanguageMode');
    const outputKanjiTextContent = document.getElementById('outputKanjiTextContent');
    const outputRomajiTextContent = document.getElementById('outputRomajiTextContent');
    const inputText = document.getElementById('inputText');
    const emotionResultText = document.getElementById('emotionResultText');




    const SpeechRecognitionClassAlias = window.SpeechRecognition || window.webkitSpeechRecognition;




    if (!SpeechRecognitionClassAlias) {
      alert('このブラウザは音声認識に対応していません。Google Chromeを使ってください。');
    } else {
      const recognitionObjectForSpeechInput = new SpeechRecognitionClassAlias();




      let currentRecognitionLanguageMode = 'ja-JP';
      recognitionObjectForSpeechInput.lang = currentRecognitionLanguageMode;
      recognitionObjectForSpeechInput.interimResults = false;




      // 言語切替ボタン
      buttonToSwitchLanguageMode.addEventListener('click', () => {
        if (currentRecognitionLanguageMode === 'ja-JP') {
          currentRecognitionLanguageMode = 'en-US';
          buttonToSwitchLanguageMode.textContent = '言語切替 (英語／日本語)';
        } else {
          currentRecognitionLanguageMode = 'ja-JP';
          buttonToSwitchLanguageMode.textContent = '言語切替 (日本語／英語)';
        }
        recognitionObjectForSpeechInput.lang = currentRecognitionLanguageMode;
        outputKanjiTextContent.textContent = `言語が${currentRecognitionLanguageMode === 'ja-JP' ? '日本語' : '英語'}に切り替わりました`;
        outputRomajiTextContent.textContent = '';
        inputText.value = '';
        emotionResultText.textContent = '---';
      });




      // 音声認識結果
      recognitionObjectForSpeechInput.onresult = (event) => {
        const spokenRecognitionResultText = event.results[0][0].transcript;
        outputKanjiTextContent.textContent = spokenRecognitionResultText;




        let romajiOutput = spokenRecognitionResultText;




        if (currentRecognitionLanguageMode === 'ja-JP') {
          const kana = wanakana.toKana(spokenRecognitionResultText);
          romajiOutput = wanakana.toRomaji(kana);
        }




        outputRomajiTextContent.textContent = romajiOutput;
        inputText.value = romajiOutput;
        analyzeEmotionFromText(romajiOutput);
      };




      recognitionObjectForSpeechInput.onerror = (event) => {
        outputKanjiTextContent.textContent = 'エラー: ' + event.error;
        outputRomajiTextContent.textContent = '';
        inputText.value = '';
        emotionResultText.textContent = '---';
      };




      buttonToStartRecognition.addEventListener('click', () => {
        outputKanjiTextContent.textContent = '🎧 聞き取り中...';
        outputRomajiTextContent.textContent = '';
        inputText.value = '';
        emotionResultText.textContent = '---';
        recognitionObjectForSpeechInput.start();
      });




      // 入力されたテキストから感情分析
      function analyzeEmotionFromText(text) {
        const happyWords = ['happy', 'joy', '嬉', '楽', 'うれ', 'たの', 'yay', 'love', '勝', '土曜', '日曜'];
        const sadWords = ['sad', 'cry', '哀', '泣', 'かな', 'つら', '悲', '失', '負', '敗', '死', '月曜', '亡'];
        const angryWords = ['angry', '怒', 'いか', 'むか', 'hate', '腹立'];
        const fearWords = ['scared', 'こわ', 'fear', 'fright', '幽霊', 'おばけ', '怖', '霊'];
        const surpriseWords = ['surprised', '驚', 'えっ', 'おどろ'];




        const waveform = document.getElementById('waveform');
        const scaleType = document.getElementById('scaleType');
        const tempo = document.getElementById('tempo');




        let emotionDetected = '中立（neutral）';




        const lowered = text.toLowerCase();
        if (happyWords.some(word => lowered.includes(word))) {
          emotionDetected = '😊 喜（happy）';
          setSelections('square', 'normal', '120');
        } else if (sadWords.some(word => lowered.includes(word))) {
          emotionDetected = '😢 哀（sad）';
          setSelections('triangle', 'wasei', '70');
        } else if (angryWords.some(word => lowered.includes(word))) {
          emotionDetected = '😠 怒（angry）';
          setSelections('square', 'wasei', '150');
        } else if (fearWords.some(word => lowered.includes(word))) {
          emotionDetected = '😨 恐（fear）';
          setSelections('sine', 'ryukyu', '90');
        } else if (surpriseWords.some(word => lowered.includes(word))) {
          emotionDetected = '😲 驚（surprise）';
          setSelections('sawtooth', 'zenon', '110');
        }




        emotionResultText.textContent = emotionDetected;
      }




      // 手動でテキストを入力された場合も感情分析
      inputText.addEventListener('input', () => {
        analyzeEmotionFromText(inputText.value);
      });
    }
  
  
          // 音色・音階・テンポのセット関数
        function setSelections(wave, scale, tempoVal) {
          waveform.value = wave;
          scaleType.value = scale;
          tempo.value = tempoVal;
        }
  
let mediaRecorder;
    let audioChunks = [];




    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const deleteBtn = document.getElementById('deleteBtn');
    const downloadLink = document.getElementById('downloadLink');
    const audioPlayback = document.getElementById('audioPlayback');




    startBtn.onclick = async () => {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream);
      audioChunks = [];




      mediaRecorder.ondataavailable = event => {
        audioChunks.push(event.data);
      };




      mediaRecorder.onstop = () => {
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        const url = URL.createObjectURL(blob);
        audioPlayback.src = url;
        downloadLink.href = url;
        downloadLink.download = 'recorded_audio.webm';
        downloadLink.style.display = 'inline';
        downloadLink.textContent = '🎧 録音をダウンロード';
        deleteBtn.disabled = false; // ← ここが大事！
      };




      mediaRecorder.start();
      startBtn.disabled = true;
      stopBtn.disabled = false;
      downloadLink.style.display = 'none';
      deleteBtn.disabled = true;
    };




    stopBtn.onclick = () => {
      mediaRecorder.stop();
      startBtn.disabled = false;
      stopBtn.disabled = true;
    };




    deleteBtn.onclick = () => {
      audioChunks = [];
      audioPlayback.src = "";
      downloadLink.href = "#";
      downloadLink.style.display = "none";
      deleteBtn.disabled = true;
    };
  
          const bpmSlider = document.getElementById('bpm-slider');
        const bpmDisplay = document.getElementById('bpm-display');
        const startStopButton = document.getElementById('start-stop-button');




        let audioEnglish = null; // audioContext を audioEnglish に変更
        let isPlaying = false;
        let nextClickTimeout = null;
        bpmSlider.addEventListener('input', () => {
        bpmDisplay.textContent = `${bpmSlider.value} BPM`;
        });




        // メトロノームを開始または停止
        startStopButton.addEventListener('click', () => {
            if (isPlaying) {
                isPlaying = false;
                clearTimeout(nextClickTimeout);
                startStopButton.textContent = "スタート";
            } else {
                if (!audioEnglish) {
                    audioEnglish = new (window.AudioContext || window.webkitAudioContext)();
                }
                isPlaying = true;
                startStopButton.textContent = "ストップ";
                scheduleClick();
            }
        });




        // 次のクリック音をスケジュール
        function scheduleClick() {
            if (!isPlaying) return;




            playClick();




            const bpm = bpmSlider.value;
            const interval = (60 / bpm) * 1000;




            nextClickTimeout = setTimeout(scheduleClick, interval);
        }




        // クリック音を再生
        function playClick() {
            if (!audioEnglish) return;




            const oscillator = audioEnglish.createOscillator();
            const gainNode = audioEnglish.createGain();




            oscillator.type = "sine";
            oscillator.frequency.setValueAtTime(1000, audioEnglish.currentTime); // 周波数：1000Hz
            gainNode.gain.setValueAtTime(0.5, audioEnglish.currentTime); // 音量：0.5




            oscillator.connect(gainNode);
            gainNode.connect(audioEnglish.destination);




            oscillator.start();
            oscillator.stop(audioEnglish.currentTime + 0.1); // 0.1秒間の音
        }
  
  
  
  
