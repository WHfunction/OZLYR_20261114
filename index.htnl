                gainNode.connect(audioContext.destination);




                const startTime = audioContext.currentTime + index * 0.5; // 0.5秒ごとに再生
                const endTime = startTime + 0.3; // 0.4秒間再生




                oscillator.start(startTime);
                oscillator.stop(endTime);
            });
        });
  
  
